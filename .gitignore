# Python cache/artifacts
__pycache__/
*.py[cod]
*.so

# Local environment folders
.venv/
venv/
.env/

# Notebook checkpoints
.ipynb_checkpoints/

# Large/local cache artifacts
activation_cache/
tinker_uq/runs/*/predictions.jsonl

# Keep only the top-level README markdown file
**/*.md
**/*.MD
!/README.md
!/README.MD

# Tinker UQ derived artifacts: regenerable, kept out of git
# datasets rebuild from evaluations_revisited/ via prepare_triviaqa.py
# (each run's prepare_manifest.json records the source hash and settings)
tinker_uq/data/*/cached_answers.jsonl
tinker_uq/demo/
tinker_uq/runs/*/predictions.jsonl
tinker_uq/runs/*/aistats/sets.jsonl
.DS_Store
